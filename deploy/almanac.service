# almanac — the golden unit, latch variant (AR17, critic #4).
#
# `latch run` spawns the service and waits (it does not exec), so latch is
# the main PID and the service's READY=1 comes from a child: NotifyAccess=all
# lets systemd accept it. ExecStartPre needs the secrets too, so it also
# runs under latch. Everything else is the plain unit.

[Unit]
Description=almanac — event-to-calendar hub
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=notify
NotifyAccess=all
User=almanac
Group=almanac
EnvironmentFile=/etc/almanac/latch.env
# 3.0.0: the state root is the 2.x layout, so nothing moves — profiles/ and
# data/ stay where they are. This file is the golden unit for a FRESH install
# (state under /opt/almanac, env file under /etc/almanac, latch's prod env).
# CT 112 differs and its unit says so: state root and env file under
# /appdata/almanac/almanac-config (the homelab's config dir), `latch run --`
# without --env, measured and installed 2026-09-06; the homelab's stack file
# is the authority for that box.
# data/ stay under /opt/almanac; the binary sits in /opt/almanac/bin.
Environment=ALMANAC_STATE_DIR=/opt/almanac
WorkingDirectory=/opt/almanac
ExecStartPre=/usr/local/bin/latch run --env prod -- /opt/almanac/bin/almanac --check
ExecStart=/usr/local/bin/latch run --env prod -- /opt/almanac/bin/almanac
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=60
# Mirrored so `--check` can warn when the shutdown timeout would outlive it (critic #20).
Environment=ALMANAC_TIMEOUT_STOP_SECS=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/opt/almanac /opt/almanac-pre-update /opt/almanac/bin
# S2: the swap needs write access to the binary's OWN directory only; a
# code-execution bug can then replace this service's binary, not latch or
# its neighbours. The rest is systemd's free hardening for a network daemon.
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
