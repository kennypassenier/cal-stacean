# almanac — the golden unit, latch variant (AR17, critic #4).
#
# `latch run` spawns the service and waits (it does not exec), so latch is
# the main PID and the service's READY=1 comes from a child: NotifyAccess=all
# lets systemd accept it. ExecStartPre needs the secrets too, so it also
# runs under latch. Everything else is the plain unit.

[Unit]
Description=almanac — Event-to-Google-Calendar hub for the homelab
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=notify
NotifyAccess=all
User=almanac
Group=almanac
EnvironmentFile=/appdata/almanac/almanac-config/latch.env
WorkingDirectory=/appdata/almanac/almanac-config
ExecStartPre=/usr/local/bin/latch run -- /opt/almanac/bin/almanac --check
ExecStart=/usr/local/bin/latch run -- /opt/almanac/bin/almanac
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=60
# Mirrored so `--check` can warn when the shutdown timeout would outlive it (critic #20).
# Explicit, not the binary's compiled-in default (CF-6 d, 2026-09-06): the
# unit says where the state lives, so a binary built with another default
# still runs against this machine's measured directory.
Environment=ALMANAC_STATE_DIR=/appdata/almanac/almanac-config
Environment=ALMANAC_TIMEOUT_STOP_SECS=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/appdata/almanac/almanac-config /appdata/almanac/almanac-config-pre-update /opt/almanac/bin
# S2: the swap needs write access to the binary's OWN directory only; a
# code-execution bug can then replace this service's binary, not latch or
# its neighbours. The rest is systemd's free hardening for a network daemon.
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
